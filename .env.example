# Environment Variables — Entangled Echo
# Copy this file to .env.local (apps/web) or .env (services/ai) and fill in values.
# NEVER commit real .env files to version control.

# ─── Data Mode ────────────────────────────────────────────────────────────────
# Controls which SocialProvider implementation is active.
# live  = real Instagram/Facebook Graph API (requires Meta app + real accounts)
# seed  = synthetic data generator (default for development & demos)
# mock  = static fixtures (unit tests, offline UI work)
DATA_MODE=seed

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Obtain from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# ─── Token Encryption ─────────────────────────────────────────────────────────
# 32 random bytes, base64-encoded.  Generate: openssl rand -base64 32
TOKEN_ENC_KEY=

# ─── Internal Tick Endpoint ───────────────────────────────────────────────────
# Shared secret used by pg_cron → /internal/tick to authenticate the request.
# Generate: openssl rand -hex 32
INTERNAL_TICK_SECRET=

# ─── AI Service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Bearer token the Next.js BFF sends to the FastAPI service.
AI_SERVICE_SECRET=

# ─── Meta / Instagram / Facebook Graph API ────────────────────────────────────
# Requires a Meta developer app with Instagram + Facebook Login products.
# See docs/DEVIATIONS.md §P1 — verify current Graph API version before use.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/callback/instagram
# Set this to the current stable Graph API version (e.g. v22.0).
# Never hardcode the version in source code; always read from this variable.
META_GRAPH_VERSION=

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# anthropic | gemini | mock
# mock logs to console and returns template captions — no API key needed.
LLM_PROVIDER=mock
LLM_API_KEY=

# ─── Email Provider ───────────────────────────────────────────────────────────
# resend | smtp | mock
# mock logs digest output to console — no API key needed.
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=noreply@entangledecho.com

# ─── App URL (used for absolute URLs in emails, media publishing, etc.) ───────
NEXT_PUBLIC_APP_URL=http://localhost:3000
